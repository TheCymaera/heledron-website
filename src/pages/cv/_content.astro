			<img class="w-full" width="1200" height="630" src="/misc/mandelbrot/thumbnail.webp" alt="6D Mandelbrot Explorer" />
			<div class="p-3">
				<h3 class="m-0">6D Mandelbrot Explorer</h3>
				<p class="m-0">
					A tool for exploring the Mandelbrot in 6 dimensions, inspired by <a href="https://www.youtube.com/watch?v=Ed1gsyxxwM0">this YouTube video</a> by 2swap.
				</p>
			</div>
		</helion-card>

		<helion-card>
			<img class="w-full" width="1200" height="630" src="/misc/buddhabrot/thumbnail.webp" alt="Buddhabrot Set Explorer" />
			<div class="p-3">
				<h3 class="m-0">Buddhabrot Explorer</h3>
				<p class="m-0">
					A tool for exploring the Buddhabrot that uses WebGPU to calculate thousands of orbits in parallel.
				</p>
			</div>
		</helion-card>

		<helion-card>
			<img class="w-full" width="1200" height="630" src="/tools/text-display-mesher/thumbnail.webp" alt="Text Display Mesher" />
