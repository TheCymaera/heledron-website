---
import { fa5_solid_bars } from "fontawesome-svgs";
import PageScaffold from "../../layouts/PageScaffold.astro";
import Content from "./_content.astro";
import contentSource from "./_content.astro?raw";

const sectionPattern = /<section\s+data-category="([^"]+)"[^>]*>([\s\S]*?)<\/section>/g;
const h2Pattern = /<h2>(.*?)<\/h2>/;

function toPlainText(value: string) {
	return value.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&").trim();
}

function toSlug(value: string) {
	return value
		.toLowerCase()
		.normalize("NFKD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/&/g, " and ")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-+|-+$/g, "") || "section";
}

const tocItems = [...contentSource.matchAll(sectionPattern)].map((match) => {
	const category = match[1]!;
	const sectionContent = match[2]!;
	const headingMatch = sectionContent.match(h2Pattern);

	if (!headingMatch) return null;

	const title = toPlainText(headingMatch[1]!);
	return {
		title,
		id: toSlug(title),
		category,
	};
}).filter(i => i !== null);

const tocGroupsByName = new Map<string, { category: string; title: string; items: typeof tocItems }>();
for (const item of tocItems) {
	const category = item.category;
	tocGroupsByName.getOrInsert(category, {
		category,
		title: category,
		items: [],
	}).items.push(item);
}

const tocGroups = Array.from(tocGroupsByName.values());


// Ensure unique IDs
if (new Set(tocItems.map((item) => item.id)).size !== tocItems.length) {
	throw new Error("Duplicate IDs.");
}
---
<style is:global>
	@reference "../../layouts/theme.css";

	section {
		break-inside: avoid;
	}

	section[data-category] {
		@apply mb-12 scroll-mt-3;
	}

	img {
		@apply bg-onSurface/5;
	}

	/* table of contents */
	.cv-toc h3 {
		@apply mt-4 ml-1 mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-onSurface/90;
	}

	.cv-toc h3:first-of-type {
		@apply mt-0;
	}

	.cv-toc a {
		@apply block rounded-md px-3 py-2 text-sm text-onSurface/80 no-underline transition-colors duration-50;

		&:hover {
			@apply bg-onSurface/6 text-onSurface;
		}

		&[aria-current="true"] {
			@apply bg-primary-600 text-onPrimary;
		}
	}

	/* drawer */
	#cv-toc-drawer {
		transform: translateX(100%);
	}
	

	html[data-cv-toc-open="true"] #cv-toc-drawer {
		transform: translateX(0);
	}

	/* drawer backdrop */
	#cv-toc-backdrop {
		opacity: 0;
		pointer-events: none;
	}

	html[data-cv-toc-open="true"] #cv-toc-backdrop {
		opacity: 1;
		pointer-events: auto;
	}

	@media print {
		h2, h3, h4, h5, h6 {
			margin-top: 0em;
			padding-top: .5em;
		}
	}
</style>
<PageScaffold
	title="About Me - Heledron"
	description="Heledron - CV"
	keywords="Heledron, Hadron, Cymaera"
	ogImage="https://heledron.com/thumbnail.webp"
>
	<div class="relative mx-auto max-w-7xl lg:grid lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-8">
		<!-- Main content -->
		<main class="max-w-4xl min-h-screen p-6 lg:pr-0 z-0">
			<main id="cv-content" class="typography scroll-smooth">
				<Content />
			</main>

			<div class="h-[50vh] print:hidden"></div>
		</main>

		<!-- Table of Contents (Desktop Only) -->
		<aside id="cv-toc-desktop" class="not-lg:hidden print:hidden">
			<div class="sticky top-6 pr-6">
				<nav class="cv-toc" aria-label="Table of contents">
					<h2 class="mb-3 text-base font-semibold">Contents</h2>
					{tocGroups.map((group) => (
						<>
							{/*<h3>{group.title}</h3>*/}
							{group.items.map((item) => (
								<a href={`#${item.id}`} class="mb-1">{item.title}</a>
							))}
						</>
					))}
				</nav>
			</div>
		</aside>

		<!-- Table of Contents Drawer (Mobile Only) -->
		<div id="cv-toc-drawer-wrapper" class="contents lg:hidden print:hidden">
			<div id="cv-toc-backdrop" class="fixed inset-0 bg-black/30 transition-opacity duration-200"></div>

			<button
				id="cv-toc-toggle"
				type="button"
				class="helion-card fixed right-4 top-4 px-4 py-3 text-sm font-medium cursor-pointer"
				aria-controls="cv-toc-drawer"
				aria-expanded="false"
			>
				<Fragment set:html={fa5_solid_bars} />
			</button>


			<aside
				id="cv-toc-drawer"
				class="fixed top-0 right-0 bottom-0 w-[min(22rem,100vw)] bg-container shadow-xl transition-transform duration-200 flex flex-col"
			>
				<div class="flex items-center justify-between border-b border-onSurface/10 px-4 py-4">
					<h2 class="m-0 text-base font-semibold">Contents</h2>
					<button id="cv-toc-close" type="button" class="rounded-md px-3 py-2 text-sm text-onSurface/80 hover:bg-onSurface/6 cursor-pointer">Close</button>
				</div>
				<nav aria-label="Table of contents mobile" class="overflow-y-auto p-4 cv-toc">
					{tocGroups.map((group) => (
						<>
							{/*<h3>{group.title}</h3>*/}
							{group.items.map((item) => (
								<a href={`#${item.id}`} class="my-1">{item.title}</a>
							))}
						</>
					))}
				</nav>
			</aside>
		</div>
	</div>

	<div data-toc-items={JSON.stringify(tocItems)}></div>

	<script>
		const tocItems = JSON.parse(document.querySelector("[data-toc-items]")!.getAttribute("data-toc-items")!);

		const root = document.documentElement;
		const contentRoot = document.getElementById("cv-content")!;
		const links = [...document.querySelectorAll<HTMLAnchorElement>('.cv-toc a')];
		const sections = [...contentRoot.querySelectorAll("h2")].map(heading => {
			const section = heading.closest("section[data-category]");
			if (!section) throw new Error("Heading found outside of section with data-category: " + heading.textContent);
			return section;
		})

		const drawer = document.getElementById("cv-toc-drawer") as HTMLElement;
		const drawerBackdrop = document.getElementById("cv-toc-backdrop") as HTMLElement;
		const drawerOpenButton = document.getElementById("cv-toc-toggle") as HTMLElement;
		const drawerCloseButton = document.getElementById("cv-toc-close") as HTMLElement;

		sections.forEach((heading, index) => {
			const item = tocItems[index];
			heading.id = item.id;
		});

		const setActiveLink = (activeId: string) => {
			for (const link of links) {
				const isActive = link.getAttribute("href") === `#${activeId}`;
				link.setAttribute("aria-current", isActive ? "true" : "false");
			}
		};

		const updateActiveHeading = () => {
			if (sections.length === 0) return;

			const margin = 80;
			let activeSection = sections[0]!;

			for (const heading of sections) {
				if (heading.getBoundingClientRect().top <= margin) {
					activeSection = heading;
				}
			}

			setActiveLink(activeSection.id);
		};

		const openDrawer = () => {
			root.dataset.cvTocOpen = "true";
			drawerOpenButton.setAttribute("aria-expanded", "true");
			drawer.inert = false;
		};

		const closeDrawer = () => {
			delete root.dataset.cvTocOpen;
			drawerOpenButton.setAttribute("aria-expanded", "false");
			drawer.inert = true;
		};

		drawerOpenButton.addEventListener("click", openDrawer);
		drawerCloseButton.addEventListener("click", closeDrawer);
		drawerBackdrop.addEventListener("click", closeDrawer);

		for (const link of links) {
			link.addEventListener("click", () => {
				closeDrawer();
			});
		}

		window.addEventListener("scroll", updateActiveHeading);
		window.addEventListener("resize", () => {
			if (!window.matchMedia("(min-width: 1024px)").matches) {
				closeDrawer();
			}
			updateActiveHeading();
		});

		updateActiveHeading();
	</script>
</PageScaffold>